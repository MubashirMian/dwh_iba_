    NULLIF(TRIM("requestedquantitypacks"), '')::INT AS requested_quantity_packs,
    NULLIF(TRIM("approvedquantitypacks"), '')::INT AS approved_quantity_packs,
    NULLIF(TRIM("receivedquantitypacks"), '')::INT AS received_quantity_packs,
    NULLIF(TRIM("consumedquantitypacks"), '')::INT AS consumed_quantity_packs,
