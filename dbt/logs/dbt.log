  create  table "dwh"."gold"."dim_medicine__dbt_tmp"
  
  
    as
  
  (
    -- dim_medicine.sql


SELECT
    ROW_NUMBER() OVER (ORDER BY medicine_id) AS medicine_sk,
    medicine_id,
    internal_sku,
    gtin14,
    generic_name,
    brand_name,
    disease_category,
    icd10_category,
    atc_code,
    therapeutic_class,
    dosage_form,
    strength,
    wholesale_price_usd,
    recommended_retail_price_usd,
    unit_manufacturing_cost_usd,
    storage_min_temp_c,
    storage_max_temp_c,
    shelf_life_months,
    effective_from_date AS effective_start_date,
    DATE '9999-12-31' AS effective_end_date,
    TRUE AS is_current_flag
FROM "dwh"."silver"."silver_master_data"
  );
  
[0m15:06:33.737423 [debug] [Thread-1 (]: On model.pharma_dwh.dim_facility: /* {"app": "dbt", "dbt_version": "1.8.7", "profile_name": "pharma_dwh", "target_name": "dev", "node_id": "model.pharma_dwh.dim_facility"} */

  
    

  create  table "dwh"."gold"."dim_facility__dbt_tmp"
  
  
    as
  
  (
    -- dim_facility.sql


WITH all_facilities AS (
    -- Commercial Pharmacies from Sales
    SELECT DISTINCT
        pharmacy_id AS facility_id,
        pharmacy_name AS facility_name,
        pharmacy_type AS facility_type,
        city,
        state
    FROM "dwh"."silver"."silver_pharmacy_sales"
    
    UNION
    
    -- Hospital Facilities from Demand
    SELECT DISTINCT
        hospital_id AS facility_id,
        hospital_name AS facility_name,
        hospital_type AS facility_type,
        city,
        state
    FROM "dwh"."silver"."silver_hospital_demand"
)
SELECT
    ROW_NUMBER() OVER (ORDER BY facility_id) AS facility_sk,
    facility_id,
    facility_name,
    facility_type,
    city,
    state,
    CASE 
        WHEN state IN ('NY', 'PA', 'MA', 'NJ') THEN 'Northeast'
        WHEN state IN ('IL', 'OH', 'MI', 'IN') THEN 'Midwest'
        WHEN state IN ('TX', 'FL', 'GA', 'NC') THEN 'South'
        ELSE 'West'
    END AS region
FROM all_facilities
  );
  
