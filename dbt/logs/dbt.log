[0m15:01:46.862244 [debug] [Thread-2 (]: On model.pharma_dwh.dim_facility: /* {"app": "dbt", "dbt_version": "1.8.7", "profile_name": "pharma_dwh", "target_name": "dev", "node_id": "model.pharma_dwh.dim_facility"} */

  
    

  create  table "dwh"."public_gold"."dim_facility__dbt_tmp"
  
  
    as
  
  (
    -- dim_facility.sql


WITH all_facilities AS (
    -- Commercial Pharmacies from Sales
    SELECT DISTINCT
        pharmacy_id AS facility_id,
        pharmacy_name AS facility_name,
        pharmacy_type AS facility_type,
        city,
        state
    FROM "dwh"."public_silver"."silver_pharmacy_sales"
    
    UNION
    
    -- Hospital Facilities from Demand
    SELECT DISTINCT
        hospital_id AS facility_id,
        hospital_name AS facility_name,
        hospital_type AS facility_type,
        city,
        state
    FROM "dwh"."public_silver"."silver_hospital_demand"
)
SELECT
    ROW_NUMBER() OVER (ORDER BY facility_id) AS facility_sk,
    facility_id,
    facility_name,
    facility_type,
    city,
    state,
    CASE 
        WHEN state IN ('NY', 'PA', 'MA', 'NJ') THEN 'Northeast'
        WHEN state IN ('IL', 'OH', 'MI', 'IN') THEN 'Midwest'
        WHEN state IN ('TX', 'FL', 'GA', 'NC') THEN 'South'
        ELSE 'West'
    END AS region
FROM all_facilities
  );
  
