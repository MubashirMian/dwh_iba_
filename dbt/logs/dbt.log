  create view "dwh"."public_silver"."silver_warehouse_inventory__dbt_tmp"
    
    
  as (
    -- silver_warehouse_inventory.sql


SELECT
    TRIM("inventorysnapshotid") AS inventory_snapshot_id,
    NULLIF(TRIM("snapshotdate"), '')::DATE AS snapshot_date,
    TRIM("warehouselotid") AS warehouse_lot_id,
    TRIM("warehouseid") AS warehouse_id,
    TRIM("warehousegln") AS warehouse_gln,
    TRIM("warehousename") AS warehouse_name,
    TRIM("storagezoneid") AS storage_zone_id,
    TRIM("productionbatchid") AS production_batch_id,
    TRIM("medicineid") AS medicine_id,
    TRIM("gtin14") AS gtin14,
    NULLIF(TRIM("batchexpirydate"), '')::DATE AS batch_expiry_date,
    NULLIF(TRIM("daystoexpiry"), '')::INT AS days_to_expiry,
    TRIM("inventorystatus") AS inventory_status,
    NULLIF(TRIM("availablequantitypacks"), '')::INT AS available_quantity_packs,
    NULLIF(TRIM("reservedquantitypacks"), '')::INT AS reserved_quantity_packs,
    NULLIF(TRIM("openingquantitypacks"), '')::INT AS opening_quantity_packs,
    NULLIF(TRIM("receivedquantitypacks"), '')::INT AS received_quantity_packs,
    NULLIF(TRIM("shippedquantitypacks"), '')::INT AS shipped_quantity_packs,
    NULLIF(TRIM("closingquantitypacks"), '')::INT AS closing_quantity_packs,
    CASE WHEN TRIM("stockoutflag") = 'Y' THEN 1 ELSE 0 END AS stockout_flag,
    CASE WHEN TRIM("nearexpiryflag") = 'Y' THEN 1 ELSE 0 END AS near_expiry_flag,
    CASE WHEN TRIM("fefocomplianceflag") = 'Y' THEN 1 ELSE 0 END AS fefo_compliance_flag,
    _loaded_at,
    _row_id
FROM bronze.warehouse_data
WHERE "inventorysnapshotid" IS NOT NULL AND TRIM("inventorysnapshotid") != ''
  );
